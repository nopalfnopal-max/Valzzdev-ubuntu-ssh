# ValzzHost Railway Template Variables
# Set ROOT_PASSWORD to a strong unique password before deploying.
ROOT_PASSWORD=

# Custom Linux hostname shown in the SSH welcome banner.
VALZZ_HOSTNAME=valzzhost

# Optional secondary SSH user; set BOTH username and password, or leave both blank.
SSH_USERNAME=
SSH_PASSWORD=

# Optional SSH public keys (paste the complete public key line).
AUTHORIZED_KEYS=
SSH_USER_AUTHORIZED_KEYS=

# SSH authentication settings. Do not disable password auth until key login is tested.
SSH_PASSWORD_AUTH=true
SSH_ROOT_LOGIN=yes
SSH_SUDO_NOPASSWD=false

# Optional Node.js runtime tuning. Leave empty unless you know the memory limit.
NODE_OPTIONS=
