{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "buildContext": ".",
    "watchPatterns": [
      "Dockerfile",
      "entrypoint.sh",
      "valzz-welcome.sh",
      "valzz-env.sh",
      "server-status.sh",
      "ssh-healthcheck.sh",
      "railway.json",
      "backup-data.sh"
    ]
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "sleepApplicationStop": true,
    "multiRegion": false
  }
}
